# ── Lazarus / Free Pascal compiled output ────────────────────────────────────

# Unit compiled files
*.ppu
*.o
*.a
*.or
*.obj

# Compiled resources (binary; regenerated from .lpr/.res)
*.compiled

# Debug symbols
*.dbg
*.rsj

# Entire compiler output tree
lib/

# ── Executable / binary ───────────────────────────────────────────────────────
ebcc
ebcc.exe

# ── Lazarus IDE session & user-specific files ─────────────────────────────────
# Project session (window positions, breakpoints, etc.)
*.lps

# Unit/project backup files created by the IDE
backup/
*.bak
*.~*
*~

# ── Runtime config (user data, not source) ───────────────────────────────────
# Main settings file written at runtime – contains serial port, window size,
# graph colours, etc. Each user has their own.
ebcc.conf

# ── OS noise ──────────────────────────────────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini